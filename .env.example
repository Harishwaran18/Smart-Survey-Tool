# Copy to .env and adjust. All variables are prefixed with SST_.

# development | test | production
SST_ENVIRONMENT=development
SST_DEBUG=false
SST_LOG_LEVEL=INFO
SST_LOG_JSON=false

# SQLite by default; point at Postgres for production
# SST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/surveys
SST_DATABASE_URL=sqlite:///./data/smart_survey.db

# Change this before deploying. Clients send it as the X-API-Key header.
SST_ADMIN_API_KEY=change-me-in-production

# Comma separated list of allowed origins
SST_CORS_ORIGINS=http://localhost:8501,http://localhost:8000

SST_API_HOST=0.0.0.0
SST_API_PORT=8000
SST_PUBLIC_BASE_URL=http://localhost:8000

# classic (offline, default) or transformer (requires the transformers extra)
SST_NLP_BACKEND=classic
SST_NLP_MAX_TOPICS=5
SST_NLP_SUMMARY_SENTENCES=3
